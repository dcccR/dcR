    "bodyHtml": "<div class=\"tscroll\"><table><tr><th></th><th>-AT → -ÁM</th><th>-IT/-ET/-ĚT → -ÍM</th></tr><tr><td>já</td><td><span class=\"cz-i\">dělám</span></td><td><span class=\"cz-i\">mluvím</span></td></tr><tr><td>ty</td><td><span class=\"cz-i\">děláš</span></td><td><span class=\"cz-i\">mluvíš</span></td></tr><tr><td>oni</td><td><span class=\"cz-i\">dělají</span></td><td><span class=\"cz-i\">mluví</span></td></tr></table></div>",
