    ],
    "bodyHtml": "<div class=\"tscroll\"><table><tr><th></th><th>肯定</th><th>否定</th></tr><tr><td>já</td><td><span class=\"cz-i\">jsem</span></td><td><span class=\"cz-i\">nejsem</span></td></tr><tr><td>ty</td><td><span class=\"cz-i\">jsi</span></td><td><span class=\"cz-i\">nejsi</span></td></tr><tr><td>on/ona/ono</td><td><span class=\"cz-i\">je</span></td><td><span class=\"cz-i\">není</span></td></tr><tr><td>my</td><td><span class=\"cz-i\">jsme</span></td><td><span class=\"cz-i\">nejsme</span></td></tr><tr><td>vy</td><td><span class=\"cz-i\">jste</span></td><td><span class=\"cz-i\">nejste</span></td></tr><tr><td>oni</td><td><span class=\"cz-i\">jsou</span></td><td><span class=\"cz-i\">nejsou</span></td></tr></table></div>",
    "relatedWordIds": []
